# ESGx.Africa Environment Configuration

# Application Settings
APP_NAME=ESGx.Africa
APP_VERSION=1.0.0
DEBUG=false

# Security
SECRET_KEY=your-super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

# Database Configuration
DATABASE_URL=postgresql://esgx_user:esgx_password@localhost:5432/esgx_africa

# Redis Configuration
REDIS_URL=redis://localhost:6379

# AI/OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key
UBUNTU_GPT_MODEL=gpt-4

# ESG Data Sources
ESG_DATA_API_KEY=your-esg-data-api-key
CARBON_API_KEY=your-carbon-data-api-key

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-email-password

# African Carbon Market APIs (Optional)
AFRICAN_CARBON_EXCHANGE_API_KEY=your-ace-api-key
SOUTH_AFRICAN_CARBON_TAX_API=your-sa-carbon-api-key

# BEE and Compliance APIs (Optional)
BEE_VERIFICATION_API_KEY=your-bee-api-key
JSE_COMPLIANCE_API_KEY=your-jse-api-key

# File Storage
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# Deployment
HOST=0.0.0.0
PORT=8000